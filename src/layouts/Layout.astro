---
import MobileMenu from '@/components/MobileMenu.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Agent-friendly playbooks for migrating legacy stacks to modern ones. Copy for Claude, Gemini, or any AI tool in one click.',
} = Astro.props;

const GITHUB_URL = 'https://github.com/helderberto/migflow';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · MigFlow</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored === 'dark' || (stored !== 'light' && prefersDark);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>

  <body
    class="bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 min-h-screen font-sans antialiased transition-colors duration-200 flex flex-col"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-green-500 focus:text-white focus:rounded-md focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <!-- Theme toggle: floats top-right, outside the main nav -->
    <button
      id="theme-toggle"
      aria-label="system — Toggle color theme"
      class="fixed top-3 right-4 z-50 flex items-center gap-1.5 text-xs px-2.5 py-1.5 rounded-md border border-zinc-200 dark:border-zinc-700 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-sm text-zinc-500 dark:text-zinc-400 hover:border-zinc-300 dark:hover:border-zinc-600 hover:text-zinc-700 dark:hover:text-zinc-200 transition-all focus-ring"
    >
      <span id="theme-icon" aria-hidden="true">◐</span>
      <span id="theme-label">system</span>
    </button>

    <header
      class="sticky top-0 z-40 border-b border-zinc-100 dark:border-zinc-800/80 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-sm"
    >
      <div class="max-w-4xl mx-auto pl-6 pr-28 h-14 flex items-center justify-between">
        <!-- Animated logo: "Migration Flow" → "MigFlow" -->
        <a
          href="/"
          class="logo-link font-mono font-bold text-base text-green-700 dark:text-green-400 hover:text-green-600 dark:hover:text-green-300 transition-colors focus-ring rounded flex items-center overflow-hidden"
          title="Migration Flow — home"
        >
          <span>Mig</span>
          <span id="logo-ration" class="logo-collapse">ration</span>
          <span class="text-zinc-400 dark:text-zinc-600 logo-space" aria-hidden="true">&nbsp;</span>
          <span id="logo-f">F</span>
          <span>low</span>
        </a>

        <div class="hidden sm:flex items-center gap-3">
          <a
            href="/agents"
            class="text-xs px-2.5 py-1.5 rounded-md text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-all focus-ring"
          >
            Agents
          </a>

          <a
            href="/submit"
            class="text-xs px-2.5 py-1.5 rounded-md border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/30 transition-all focus-ring"
          >
            Submit
          </a>

          <a
            href={GITHUB_URL}
            class="text-xs text-zinc-500 dark:text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors focus-ring rounded"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View source on GitHub (opens in new tab)"
          >
            GitHub ↗
          </a>
        </div>

        <MobileMenu githubUrl={GITHUB_URL} />
      </div>
    </header>

    <main id="main" class="flex-1 max-w-4xl w-full mx-auto px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-zinc-100 dark:border-zinc-800 mt-16">
      <div
        class="max-w-4xl mx-auto px-6 py-8 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400"
      >
        <span>MIT License · Helder Burato Berto</span>
        <span>Built for AI-assisted migrations</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* =====================================================
     Design tokens
     ===================================================== */
  :root {
    /* Brand (green) */
    --color-brand: #15803d; /* green-700 — primary CTAs */
    --color-brand-hover: #16a34a; /* green-600 */
    --color-brand-active: #166534; /* green-800 */
    --color-brand-subtle: #f0fdf4; /* green-50 */
    --color-brand-muted: #86efac; /* green-300 */

    /* Success / copy-confirmation state */
    --color-success-fg: #16a34a; /* green-600 */
    --color-success-surface: #f0fdf4; /* green-50 */
    --color-success-border: #86efac; /* green-300 */

    /* Neutral surfaces */
    --color-surface-raised: #f4f4f5; /* zinc-100 */
    --color-surface-hover: #e8e8ea;

    /* Borders */
    --color-border: #e4e4e7; /* zinc-200 */

    /* Text */
    --color-text-muted: #a1a1aa; /* zinc-400 */
    --color-text-secondary: #52525b; /* zinc-600 — hover/active states */
    --color-text-dimmed: #52525b; /* zinc-600 on zinc-100 bg = 6.18:1 — code block labels */

    /* Spacing */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;

    /* Border radii */
    --radius-sm: 0.375rem; /* rounded-md  (6px)  */
    --radius-md: 0.5rem; /* rounded-lg  (8px)  */
    --radius-lg: 0.75rem; /* rounded-xl  (12px) */
    --radius-full: 9999px;

    /* Typography */
    --font-2xs: 0.6875rem; /* ~11px — code block labels */
  }

  html.dark {
    /* Success state flips to dark-green palette */
    --color-success-fg: #4ade80; /* green-400 */
    --color-success-surface: #052e16; /* green-950 */
    --color-success-border: #166534; /* green-800 */

    /* Surfaces */
    --color-surface-raised: #1c1c1f;
    --color-surface-hover: #2d2d31;

    /* Borders */
    --color-border: #3f3f46; /* zinc-700 */

    /* Text */
    --color-text-secondary: #d4d4d8; /* zinc-200 */
    --color-text-dimmed: #a1a1aa; /* zinc-400 on dark surface — subtle code block labels */
  }

  /* =====================================================
     Utilities
     ===================================================== */
  .focus-ring {
    @apply outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-zinc-950;
  }

  /* Primary action button */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-brand);
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-lg);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .btn-primary:hover {
    background-color: var(--color-brand-hover);
  }
  .btn-primary:active {
    background-color: var(--color-brand-active);
  }

  /* Form input / select / textarea */
  .input-base {
    @apply w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl px-4 py-3 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all text-sm;
  }

  /* =====================================================
     Logo animation
     ===================================================== */
  .logo-collapse {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    max-width: 3.75rem;
    opacity: 1;
    transition:
      max-width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  .logo-collapse.collapsed {
    max-width: 0;
    opacity: 0;
  }

  .logo-link:hover .logo-collapse.collapsed,
  .logo-link:focus-visible .logo-collapse.collapsed {
    max-width: 3.75rem;
    opacity: 1;
  }

  .logo-space {
    display: inline-block;
    overflow: hidden;
    max-width: 0.375rem;
    opacity: 1;
    transition:
      max-width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
  }

  .logo-space.collapsed {
    max-width: 0;
    opacity: 0;
  }

  .logo-link:hover .logo-space.collapsed,
  .logo-link:focus-visible .logo-space.collapsed {
    max-width: 0.375rem;
    opacity: 1;
  }

  /* =====================================================
     Code blocks
     ===================================================== */
  .code-block-wrapper {
    margin: 1.25rem 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border);
  }

  .code-block-lang {
    font-size: var(--font-2xs);
    font-family: ui-monospace, monospace;
    font-weight: 500;
    color: var(--color-text-dimmed);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .code-block-copy {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-2xs);
    font-family: inherit;
    color: var(--color-text-dimmed);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0.2rem var(--space-2);
    margin-right: calc(-1 * var(--space-2));
    border-radius: var(--radius-sm);
    transition:
      background-color 0.12s,
      color 0.12s;
  }

  .code-block-copy:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text-secondary);
  }

  .code-block-wrapper pre.astro-code {
    margin: 0 !important;
    border-radius: 0 !important;
    border: none !important;
  }

  /* Reset inline-code styles that leak into Shiki blocks */
  .prose pre code {
    background-color: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-size: inherit !important;
    color: inherit !important;
  }

  /* Hide Shiki's trailing empty line */
  .astro-code .line:last-child:empty {
    display: none;
  }

  /* github-dark comment color (#6A737D) fails WCAG AA (3.04:1) — boost to #9ca3af (5.4:1) */
  html.dark .astro-code span[style*='--shiki-dark:#6A737D'],
  html.dark .astro-code span[style*='--shiki-dark:#6a737d'] {
    color: #9ca3af !important;
  }

  /* =====================================================
     Copy / clipboard states
     ===================================================== */
  .copy-btn.is-copied[data-variant='primary'] {
    background-color: var(--color-brand);
  }

  .copy-btn.is-copied[data-variant='default'] {
    background-color: var(--color-success-surface);
    border-color: var(--color-success-border);
    color: var(--color-success-fg);
  }

  .code-block-copy.is-copied {
    color: var(--color-success-fg) !important;
  }

  /* =====================================================
     Shiki dual-theme
     ===================================================== */
  .astro-code,
  .astro-code span {
    color: var(--shiki-light) !important;
    background-color: var(--shiki-light-bg) !important;
  }

  html.dark .astro-code,
  html.dark .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
</style>

<script>
  import { THEME_ICONS, nextTheme, readStoredTheme, resolveDarkMode } from '@/lib';
  import type { Theme } from '@/types';

  // Logo animation: "Migration Flow" → "MigFlow" (runs once per session)
  const ration = document.getElementById('logo-ration');
  const space = document.querySelector<HTMLElement>('.logo-space');

  if (!sessionStorage.getItem('logo-animated')) {
    setTimeout(() => {
      ration?.classList.add('collapsed');
      space?.classList.add('collapsed');
      sessionStorage.setItem('logo-animated', '1');
    }, 1200);
  } else {
    ration?.classList.add('collapsed');
    space?.classList.add('collapsed');
  }

  // Theme toggle
  const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const themeLabel = document.getElementById('theme-label') as HTMLSpanElement;
  const themeIcon = document.getElementById('theme-icon') as HTMLSpanElement;

  function applyTheme(theme: Theme) {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', resolveDarkMode(theme, prefersDark));
    themeLabel.textContent = theme;
    themeIcon.textContent = THEME_ICONS[theme];
    btn.setAttribute('aria-label', `${theme} — Toggle color theme`);
    localStorage.setItem('theme', theme);
  }

  applyTheme(readStoredTheme(localStorage));

  btn.addEventListener('click', () => {
    applyTheme(nextTheme(readStoredTheme(localStorage)));
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (readStoredTheme(localStorage) === 'system') applyTheme('system');
  });
</script>
