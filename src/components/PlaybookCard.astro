---
import { categoryMeta } from '@/lib';
import type { Category } from '@/types';

interface Props {
  slug: string;
  from: string;
  to: string;
  tags: readonly string[];
  description: string;
  category: Category;
}

const { slug, from, to, tags, description, category } = Astro.props;
const meta = categoryMeta[category];
---

<li
  class="playbook-item"
  role="listitem"
  data-from={from.toLowerCase()}
  data-to={to.toLowerCase()}
  data-tags={tags.join(' ').toLowerCase()}
  data-description={description.toLowerCase()}
  data-category={category}
>
  <a
    href={`/playbooks/${slug}`}
    class={`group flex items-center gap-4 border-l-2 ${meta.color} border border-zinc-100 dark:border-zinc-800 rounded-xl pl-4 pr-5 py-4 hover:border-zinc-200 dark:hover:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-900/60 hover:shadow-sm transition-all duration-150`}
  >
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${meta.pill}`}>
          {category}
        </span>
      </div>
      <p
        class="font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-zinc-900 dark:group-hover:text-white transition-colors"
      >
        {from}
        <span class="text-zinc-300 dark:text-zinc-600 mx-1.5 font-normal">→</span>
        {to}
      </p>
      <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-0.5 truncate">
        {description}
      </p>
    </div>
    <svg
      class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-green-500 dark:group-hover:text-green-400 transition-colors flex-shrink-0 -translate-x-1 group-hover:translate-x-0 duration-150"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path d="M9 18l6-6-6-6"></path>
    </svg>
  </a>
</li>
