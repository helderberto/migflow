---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const playbooks = await getCollection('playbooks');
const count = playbooks.filter((p) => !p.data.draft).length;
---

<Layout
  title="Agents"
  description="Connect MigFlow to Claude, Cursor, Windsurf, and any AI agent through MCP, a JSON API, or llms.txt."
>
  <!-- Hero -->
  <section class="mb-12" aria-label="Introduction">
    <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
      Use MigFlow with<br />
      <span class="text-green-600 dark:text-green-400">your agents.</span>
    </h1>
    <p class="text-zinc-500 dark:text-zinc-400 max-w-md leading-relaxed">
      {count} playbooks exposed through three channels so agents and scripts can consume them programmatically
      — no scraping required.
    </p>
  </section>

  <!-- MCP section -->
  <section class="mb-12" aria-labelledby="mcp-heading">
    <div class="flex items-center gap-2 mb-2">
      <span
        class="text-xs px-2 py-0.5 rounded-full font-medium bg-green-50 dark:bg-green-400/10 text-green-700 dark:text-green-300"
      >
        recommended
      </span>
      <h2
        id="mcp-heading"
        class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50"
      >
        MCP — Model Context Protocol
      </h2>
    </div>
    <p class="text-zinc-500 dark:text-zinc-400 mb-6 leading-relaxed">
      Native integration for Claude Code, Claude Desktop, Cursor, Windsurf, and any MCP-compatible
      client. The agent can list, fetch, and search playbooks as first-class tools.
    </p>

    <div class="space-y-6">
      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">Endpoint</h3>
        <pre
          class="overflow-x-auto"><code class="text-sm font-mono bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 rounded-lg px-3 py-2 inline-block">__ORIGIN__/api/mcp</code></pre>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">Available tools</h3>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li>
            <code class="font-mono text-green-700 dark:text-green-400"
              >list_playbooks(category?, tag?)</code
            > — list all playbooks, optionally filtered.
          </li>
          <li>
            <code class="font-mono text-green-700 dark:text-green-400">get_playbook(slug)</code> — fetch
            a single playbook with full markdown body and metadata.
          </li>
          <li>
            <code class="font-mono text-green-700 dark:text-green-400">search_playbooks(query)</code
            > — free-text search across titles, descriptions, tags, and bodies.
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">
          Claude Desktop config
        </h3>
        <pre
          class="text-xs leading-relaxed bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 rounded-lg p-3 overflow-x-auto"><code>{`{
  "mcpServers": {
    "migflow": {
      "url": "$__ORIGIN__/api/mcp"
    }
  }
}`}</code></pre>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">
          Test with the MCP Inspector
        </h3>
        <pre
          class="text-xs leading-relaxed bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 rounded-lg p-3 overflow-x-auto"><code>{`npx @modelcontextprotocol/inspector $__ORIGIN__/api/mcp`}</code></pre>
      </div>
    </div>
  </section>

  <!-- JSON API section -->
  <section class="mb-12" aria-labelledby="json-heading">
    <h2
      id="json-heading"
      class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 mb-2"
    >
      JSON API
    </h2>
    <p class="text-zinc-500 dark:text-zinc-400 mb-6 leading-relaxed">
      For scripts, CI pipelines, and non-MCP automation. Plain HTTP, no protocol overhead.
    </p>

    <div class="space-y-6">
      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">Endpoints</h3>
        <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li>
            <a
              href="/playbooks.json"
              class="font-mono text-green-700 dark:text-green-400 hover:underline"
              >GET /playbooks.json</a
            >
            — full list with metadata for every playbook.
          </li>
          <li>
            <code class="font-mono text-green-700 dark:text-green-400"
              >GET /playbooks/&lt;slug&gt;.json</code
            >
            — single playbook with raw markdown body and pre-formatted prompts (Claude / Gemini).
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">Example</h3>
        <pre
          class="text-xs leading-relaxed bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 rounded-lg p-3 overflow-x-auto"><code>{`curl $__ORIGIN__/playbooks.json | jq '.playbooks[].slug'

curl $__ORIGIN__/playbooks/enzyme-to-rtl.json | jq '.prompts.claude'`}</code></pre>
      </div>
    </div>
  </section>

  <!-- llms.txt section -->
  <section class="mb-12" aria-labelledby="llms-heading">
    <h2
      id="llms-heading"
      class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 mb-2"
    >
      llms.txt
    </h2>
    <p class="text-zinc-500 dark:text-zinc-400 mb-6 leading-relaxed">
      Follows the <a
        href="https://llmstxt.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-green-700 dark:text-green-400 hover:underline">llmstxt.org</a
      > convention. Use it for RAG indexers, ChatGPT context loaders, or any tool that ingests structured
      site maps.
    </p>

    <div class="space-y-6">
      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">Endpoint</h3>
        <p class="text-sm">
          <a href="/llms.txt" class="font-mono text-green-700 dark:text-green-400 hover:underline"
            >GET /llms.txt</a
          >
          — index of all playbooks grouped by category, each linked to its JSON endpoint.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-2">Example</h3>
        <pre
          class="text-xs leading-relaxed bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 rounded-lg p-3 overflow-x-auto"><code>{`curl $__ORIGIN__/llms.txt`}</code></pre>
      </div>
    </div>
  </section>

  <!-- Footer note -->
  <p
    class="text-xs text-zinc-500 dark:text-zinc-400 border-t border-zinc-100 dark:border-zinc-800 pt-6"
  >
    All three channels share the same content. Pick the one that best fits your client.
  </p>
</Layout>

<script is:inline>
  (function () {
    const origin = window.location.origin;
    document.querySelectorAll('code, pre, a[href]').forEach((el) => {
      if (el.tagName === 'A') {
        const href = el.getAttribute('href');
        if (href && href.includes('__ORIGIN__')) {
          el.setAttribute('href', href.replaceAll('__ORIGIN__', origin));
        }
      }
      if (el.textContent && el.textContent.includes('__ORIGIN__')) {
        el.textContent = el.textContent.replaceAll('__ORIGIN__', origin);
      }
    });
  })();
</script>
