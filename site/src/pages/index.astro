---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, categoryMeta } from "../lib/playbooks";

const allPlaybooks = await getCollection("playbooks");
const playbooks = allPlaybooks
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.from.localeCompare(b.data.from));

const categories = ["all", ...CATEGORIES] as const;
---

<Layout title="Playbooks">
  <!-- Hero -->
  <section class="mb-12" aria-label="Introduction">
    <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
      Stack migrations,<br />
      <span class="text-green-600 dark:text-green-400">AI-ready.</span>
    </h1>
    <p class="text-zinc-500 dark:text-zinc-400 max-w-md leading-relaxed">
      Structured playbooks for migrating legacy stacks to modern ones.
      Copy for Claude, Gemini, or any AI tool — one click.
    </p>
    <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">
      {playbooks.length} {playbooks.length === 1 ? "playbook" : "playbooks"} available
    </p>
  </section>

  <!-- Search -->
  <div class="relative mb-4">
    <label for="search" class="sr-only">Search migrations</label>
    <svg
      class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500 dark:text-zinc-400 pointer-events-none"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      id="search"
      type="search"
      placeholder="Search migrations… (e.g. enzyme, cypress, typescript)"
      class="w-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl pl-10 pr-4 py-3 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all text-sm"
      autocomplete="off"
      spellcheck="false"
    />
  </div>

  <!-- Category filters -->
  <div class="flex gap-2 flex-wrap mb-2" role="group" aria-label="Filter by category">
    {
      categories.map((cat) => (
        <button
          class="category-btn text-xs px-3 py-1.5 rounded-full border font-medium transition-all cursor-pointer focus-ring"
          data-category={cat}
          aria-pressed={cat === "all" ? "true" : "false"}
        >
          {cat === "all" ? "All" : cat}
        </button>
      ))
    }
  </div>

  <!-- Results feedback -->
  <p
    id="results-count"
    class="text-xs text-zinc-500 dark:text-zinc-400 h-6 flex items-center mb-4"
    aria-live="polite"
    aria-atomic="true"
  >
  </p>

  <!-- Playbook list -->
  <ul id="playbook-list" class="flex flex-col gap-2" role="list">
    {
      playbooks.map((p) => (
        <li class="playbook-item" role="listitem" data-from={p.data.from.toLowerCase()} data-to={p.data.to.toLowerCase()} data-tags={p.data.tags.join(" ").toLowerCase()} data-description={p.data.description.toLowerCase()} data-category={p.data.category}>
          <a
            href={`/playbooks/${p.slug}`}
            class={`group flex items-center gap-4 border-l-2 ${categoryMeta[p.data.category].color} border border-zinc-100 dark:border-zinc-800 rounded-xl pl-4 pr-5 py-4 hover:border-zinc-200 dark:hover:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-900/60 hover:shadow-sm transition-all duration-150`}
          >
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${categoryMeta[p.data.category].pill}`}>
                  {p.data.category}
                </span>
              </div>
              <p class="font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-zinc-900 dark:group-hover:text-white transition-colors">
                {p.data.from}
                <span class="text-zinc-300 dark:text-zinc-600 mx-1.5 font-normal">→</span>
                {p.data.to}
              </p>
              <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-0.5 truncate">
                {p.data.description}
              </p>
            </div>
            <svg
              class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-green-500 dark:group-hover:text-green-400 transition-colors flex-shrink-0 -translate-x-1 group-hover:translate-x-0 duration-150"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        </li>
      ))
    }
  </ul>

  <p
    id="no-results"
    class="hidden text-zinc-500 dark:text-zinc-400 text-sm text-center py-16"
    aria-live="polite"
  >
    No playbooks match your search.
  </p>
</Layout>

<style>
  .category-btn[aria-pressed="true"] {
    @apply bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 border-zinc-900 dark:border-zinc-100;
  }
  .category-btn[aria-pressed="false"] {
    @apply bg-transparent text-zinc-500 dark:text-zinc-400 border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 hover:text-zinc-700 dark:hover:text-zinc-200;
  }
</style>

<script>
  const search = document.getElementById("search") as HTMLInputElement;
  const items = document.querySelectorAll<HTMLLIElement>(".playbook-item");
  const noResults = document.getElementById("no-results") as HTMLParagraphElement;
  const resultsCount = document.getElementById("results-count") as HTMLParagraphElement;
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>(".category-btn");

  let activeCategory = "all";

  function filter() {
    const query = search.value.toLowerCase().trim();
    let visible = 0;

    items.forEach((item) => {
      const haystack = [
        item.dataset.from,
        item.dataset.to,
        item.dataset.tags,
        item.dataset.description,
        item.dataset.category,
      ].join(" ");

      const matchesText = query === "" || haystack.includes(query);
      const matchesCategory =
        activeCategory === "all" || item.dataset.category === activeCategory;
      const match = matchesText && matchesCategory;

      item.style.display = match ? "" : "none";
      if (match) visible++;
    });

    const total = items.length;
    noResults.classList.toggle("hidden", visible > 0);

    if (query !== "" || activeCategory !== "all") {
      resultsCount.textContent = `${visible} of ${total} playbooks`;
    } else {
      resultsCount.textContent = "";
    }
  }

  search.addEventListener("input", filter);

  categoryBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.category ?? "all";
      categoryBtns.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");
      filter();
    });
  });
</script>
