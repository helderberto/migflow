---
import Layout from "../../layouts/Layout.astro";
import CopyButton from "../../components/CopyButton.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const playbooks = await getCollection("playbooks");
  return playbooks.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const playbook = await getEntry("playbooks", slug);

if (!playbook) {
  return Astro.redirect("/404");
}

const { Content } = await playbook.render();
const { from, to, category, tags, description } = playbook.data;

const claudeContent = [
  `You are an expert developer performing a code migration from ${from} to ${to}.`,
  `Follow this playbook strictly. Prioritize correctness and idiomatic ${to} patterns.`,
  `Do not leave any ${from} patterns in the migrated code.`,
  `\n---\n`,
  playbook.body,
].join("\n");

const geminiContent = [
  `Act as a senior software engineer. Migrate the following code from ${from} to ${to}.`,
  `Follow the playbook below. Validate each change against the pitfalls listed.`,
  `\n---\n`,
  playbook.body,
].join("\n");

const categoryMeta: Record<string, { pill: string; border: string }> = {
  frontend: {
    pill: "text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-400/10",
    border: "border-l-blue-400",
  },
  backend: {
    pill: "text-purple-700 dark:text-purple-300 bg-purple-50 dark:bg-purple-400/10",
    border: "border-l-purple-400",
  },
  data: {
    pill: "text-orange-700 dark:text-orange-300 bg-orange-50 dark:bg-orange-400/10",
    border: "border-l-orange-400",
  },
  language: {
    pill: "text-cyan-700 dark:text-cyan-300 bg-cyan-50 dark:bg-cyan-400/10",
    border: "border-l-cyan-400",
  },
  infra: {
    pill: "text-yellow-700 dark:text-yellow-300 bg-yellow-50 dark:bg-yellow-400/10",
    border: "border-l-yellow-400",
  },
};
---

<Layout title={`${from} → ${to}`} description={description}>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="mb-8">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-400 dark:text-zinc-500 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors focus-ring rounded group"
    >
      <svg
        class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      All playbooks
    </a>
  </nav>

  <!-- Header -->
  <header class="mb-8">
    <div class="flex items-center gap-2 mb-3">
      <span class={`text-xs px-2.5 py-1 rounded-full font-medium ${categoryMeta[category].pill}`}>
        {category}
      </span>
      {
        tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
            {tag}
          </span>
        ))
      }
    </div>

    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3">
      {from}
      <span class="text-green-500 mx-2">→</span>
      {to}
    </h1>
    <p class="text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-xl">{description}</p>
  </header>

  <!-- Copy panel -->
  <section
    class="mb-10 flex flex-col sm:flex-row sm:items-center gap-3 px-4 py-3.5 rounded-xl border border-zinc-100 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40"
    aria-label="Copy playbook"
  >
    <p class="text-xs text-zinc-400 dark:text-zinc-500 font-medium shrink-0">Copy for</p>
    <div class="flex gap-2 flex-wrap">
      <CopyButton label="Claude Code" content={claudeContent} variant="primary" />
      <CopyButton label="Gemini" content={geminiContent} />
      <CopyButton label="Raw markdown" content={playbook.body} />
    </div>
  </section>

  <!-- Playbook content -->
  <article
    class="prose prose-zinc dark:prose-invert max-w-none
      prose-headings:font-semibold prose-headings:tracking-tight
      prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
      prose-h3:text-base prose-h3:mt-6 prose-h3:mb-3
      prose-p:text-zinc-600 dark:prose-p:text-zinc-400 prose-p:leading-relaxed
      prose-li:text-zinc-600 dark:prose-li:text-zinc-400
      prose-strong:text-zinc-800 dark:prose-strong:text-zinc-200
      prose-code:text-green-700 dark:prose-code:text-green-300
      prose-code:bg-zinc-100 dark:prose-code:bg-zinc-800/80
      prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono
      prose-code:before:content-none prose-code:after:content-none
      prose-pre:rounded-none prose-pre:my-0
      prose-table:text-sm prose-th:font-semibold
      prose-a:text-green-600 dark:prose-a:text-green-400 prose-a:no-underline hover:prose-a:underline"
  >
    <Content />
  </article>
</Layout>

<script>
  document.querySelectorAll("pre.astro-code").forEach((pre) => {
    const lang = pre.getAttribute("data-language") ?? "";

    const wrapper = document.createElement("div");
    wrapper.className = "code-block-wrapper";

    const header = document.createElement("div");
    header.className = "code-block-header";

    const langBadge = document.createElement("span");
    langBadge.className = "code-block-lang";
    langBadge.textContent = lang || "code";

    const copyBtn = document.createElement("button");
    copyBtn.className = "code-block-copy";
    copyBtn.setAttribute("aria-label", `Copy ${lang || "code"}`);
    copyBtn.innerHTML = [
      `<svg class="cb-copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">`,
      `<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>`,
      `</svg>`,
      `<svg class="cb-check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="display:none">`,
      `<polyline points="20 6 9 17 4 12"/>`,
      `</svg>`,
      `<span class="cb-label">Copy</span>`,
    ].join("");

    copyBtn.addEventListener("click", () => {
      if (copyBtn.classList.contains("is-copied")) return;
      const code = pre.querySelector("code") as HTMLElement | null;
      const text = code?.innerText ?? "";
      navigator.clipboard.writeText(text).then(() => {
        const copyIcon = copyBtn.querySelector(".cb-copy-icon") as HTMLElement;
        const checkIcon = copyBtn.querySelector(".cb-check-icon") as HTMLElement;
        const label = copyBtn.querySelector(".cb-label") as HTMLElement;
        copyIcon.style.display = "none";
        checkIcon.style.display = "";
        label.textContent = "Copied";
        copyBtn.classList.add("is-copied");
        setTimeout(() => {
          copyIcon.style.display = "";
          checkIcon.style.display = "none";
          label.textContent = "Copy";
          copyBtn.classList.remove("is-copied");
        }, 1500);
      });
    });

    header.appendChild(langBadge);
    header.appendChild(copyBtn);

    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(header);
    wrapper.appendChild(pre);
  });
</script>
